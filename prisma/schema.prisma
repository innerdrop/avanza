generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  name                String?
  password            String
  role                String               @default("user")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  plan                String               @default("basic")
  jobPostings         JobPosting[]
  premiumSubscription PremiumSubscription?
}

model PremiumSubscription {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  amount      Float     @default(15000)
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  cancelledAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobPosting {
  id                Int           @id @default(autoincrement())
  title             String
  company           String
  location          String
  type              String
  description       String
  requirements      String
  responsibilities  String
  benefits          String
  salary            String
  status            String        @default("pending")
  expiresAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  featuredExpiresAt DateTime?
  isFeatured        Boolean       @default(false)
  companyUserId     Int?
  applications      Application[]
  companyUser       User?         @relation(fields: [companyUserId], references: [id])
  payments          Payment[]
}

model Payment {
  id           Int        @id @default(autoincrement())
  jobPostingId Int
  amount       Float
  status       String     @default("pending")
  provider     String?
  externalId   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
}

model Application {
  id             Int         @id @default(autoincrement())
  jobPostingId   Int?
  nombre         String
  email          String
  telefono       String
  linkedin       String?
  area           String
  experiencia    String
  disponibilidad String
  presentacion   String?
  cvUrl          String?
  status         String      @default("pending")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  jobPosting     JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  cVAnalysis     CVAnalysis?
}

model ContentBlock {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PsychometricTest {
  id         Int      @id @default(autoincrement())
  email      String
  nombre     String
  respuestas String
  resultado  String
  createdAt  DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  nombre    String
  empresa   String?
  email     String
  telefono  String?
  servicio  String?
  mensaje   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CVAnalysis {
  id                     Int         @id @default(autoincrement())
  applicationId          Int         @unique
  professionalSummary    String?
  skills                 String[]
  yearsOfExperience      Int?
  education              String?
  workExperience         String?
  languages              String[]
  aiModelUsed            String      @default("gemini-1.5-flash")
  rawResponse            String?
  createdAt              DateTime    @default(now())
  dni                    String?
  email                  String?
  fullName               String?
  hasPrimaryEducation    Boolean     @default(false)
  hasSecondaryEducation  Boolean     @default(false)
  hasTertiaryEducation   Boolean     @default(false)
  hasUniversityEducation Boolean     @default(false)
  knowledge              String[]
  location               String?
  maritalStatus          String?
  phone                  String?
  universityTitle        String?
  application            Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Advertisement {
  id              Int       @id @default(autoincrement())
  title           String
  description     String?
  imageUrl        String?
  linkUrl         String?
  level           Int
  position        String
  isActive        Boolean   @default(true)
  startDate       DateTime?
  endDate         DateTime?
  daysContracted  Int       @default(7)
  pricePerDay     Float
  totalPrice      Float?
  clicks          Int       @default(0)
  impressions     Int       @default(0)
  advertiserName  String?
  advertiserEmail String?
  advertiserPhone String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
